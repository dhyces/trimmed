{
  "type": "trimmed:template_generator",
  "asset_name_template": "${item_texture}_${material_suffix}_trim",
  "template": "trimmed:item/two_layer_trim",
  "replace": {
    "item_texture": {
      "type": "trimmed:map_keys",
      "map_type": "trimmed:texture_mapping",
      "map_key": "trimmed:trim_overlays"
    },
    "trim_overlay_texture": {
      "type": "trimmed:map_values",
      "map_type": "trimmed:texture_mapping",
      "map_key": "trimmed:trim_overlays"
    },
    "material_suffix": {
      "type": "trimmed:permute",
      "method": {
        "type": "trimmed:all",
        "maps": [
          {
            "type": "trimmed:map_values",
            "map_type": "trimmed:texture_suffix",
            "map_key": "trimmed:material_suffixes"
          },
          {
            "type": "trimmed:map_replace",
            "map_type": "trimmed:texture_suffix",
            "map_key": "trimmed:material_suffixes"
          }
        ]
      }
    }
  }
}